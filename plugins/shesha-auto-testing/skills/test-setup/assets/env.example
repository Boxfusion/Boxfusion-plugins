# Test credentials & config — copy this file to `.env` and fill in the real values.
#
#   cp .env.example .env
#
# `.env` is gitignored — it must NEVER be committed. In CI, set these as
# secrets/variables instead of committing a .env file. `playwright.config.ts`
# loads `.env` into process.env; the generated specs read from there.

# ── Environment (which site to run against) ─────────────────────────────────
# Active site. playwright.config.ts resolves baseURL from <TEST_ENV>_APP_URL,
# unless a single APP_URL is set (which overrides it). Specs use relative paths,
# so changing TEST_ENV re-points every test.
TEST_ENV=qa

# One URL per environment (add as many as you need). URLs are not secret, but
# live here so you can switch sites without editing committed files.
QA_APP_URL=
# TEST_APP_URL=
# STAGING_APP_URL=

# Optional single-site override (wins over <TEST_ENV>_APP_URL):
# APP_URL=

# ── Credentials (one pair per role) ─────────────────────────────────────────
# The spec's loginAs(page, 'ROLE') helper reads <ROLE>_USERNAME / <ROLE>_PASSWORD.
# Add a pair per role your tests log in as.
ADMIN_USERNAME=
ADMIN_PASSWORD=
# MANAGER_USERNAME=
# MANAGER_PASSWORD=
# USER_USERNAME=
# USER_PASSWORD=
