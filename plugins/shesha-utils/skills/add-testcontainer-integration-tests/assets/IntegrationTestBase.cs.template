    public static class SettingsHelpers
    {
        public static void AddOrUpdateAppSetting<T>(string sectionPathKey, T value, string? filePath = null)
        {
            try
            {
                filePath ??= Path.Combine(AppContext.BaseDirectory, "appsettings.json");
                string json = File.ReadAllText(filePath);
                dynamic jsonObj = Newtonsoft.Json.JsonConvert.DeserializeObject(json)!;

                SetValueRecursively(sectionPathKey, jsonObj, value);

                string output = Newtonsoft.Json.JsonConvert.SerializeObject(jsonObj, Newtonsoft.Json.Formatting.Indented);
                File.WriteAllText(filePath, output);
            }
            catch (Exception ex)
            {
                // Carrying on would boot the app against whatever database appsettings.json already points at
                throw new InvalidOperationException($"Error writing app setting '{sectionPathKey}' to '{filePath}'", ex);
            }
        }

        private static void SetValueRecursively<T>(string sectionPathKey, dynamic jsonObj, T value)
        {
            // split the string at the first ':' character
            var remainingSections = sectionPathKey.Split(":", 2);

            var currentSection = remainingSections[0];
            if (remainingSections.Length > 1)
            {
                // continue with the process, moving down the tree
                SetValueRecursively(remainingSections[1], jsonObj[currentSection], value);
            }
            else
            {
                // we've got to the end of the tree, set the value
                jsonObj[currentSection] = value;
            }
        }
    }

    /// <summary>
    /// Starts one SQL Server container and one in-process test server for the whole test run.
    /// </summary>
    public sealed class DatabaseFixture : IDisposable
    {
        public MsSqlContainer dbContainer;
        public string connectionString;
        private ProductTestServer _server;

        private bool _routesRefreshed = false;

        public async Task<ProductTestServer> GetServerAsync()
        {
            if (!_routesRefreshed)
            {
                await RefreshDynamicRoutesAsync();
                // only after it succeeds, so a failed setup is retried by the next test instead of skipped
                _routesRefreshed = true;
            }
            return _server;
        }

        /// <summary>
        /// Rebuilds the dynamic CRUD route table.
        ///
        /// Shesha generates the /api/dynamic/{module}/{Entity}/Crud/* controllers from the
        /// Frwk_EntityConfigs rows, and MVC populates that controller feature once and caches it.
        /// On a blank database those rows are only written later in the same startup by the
        /// EntityConfigsBootstrapper, so the entities end up with no route and every call returns
        /// 404 for the whole process. Cancelling the change token makes MVC re-run the feature
        /// provider against the rows the bootstrapper has now written.
        /// </summary>
        private static async Task RefreshDynamicRoutesAsync()
        {
            var changeProvider = SheshaActionDescriptorChangeProvider.Instance;
            if (changeProvider == null)
                return;

            changeProvider.HasChanged = true;

            // Null until MVC has asked for a change token, i.e. until the routes have been built at least once.
            var tokenSource = changeProvider.TokenSource;
            if (tokenSource != null)
                await tokenSource.CancelAsync();
        }

        public DatabaseFixture()
        {
            try
            {
                dbContainer = new MsSqlBuilder()
                    .WithImage("robjomar/shesha-mssql-blank")
                    .WithPassword("Acc@12345")
                    .Build();

                // Start the container and wait for it synchronously
                AsyncHelper.RunSync(async () => await dbContainer.StartAsync());

                // By default, database name is 'master'; SheshaTestHelper only resets databases named as test databases
                var builder = new SqlConnectionStringBuilder(dbContainer.GetConnectionString())
                {
                    InitialCatalog = "Shesha_IntegrationTests"
                };
                connectionString = builder.ToString();

                // Point the application at the container
                SettingsHelpers.AddOrUpdateAppSetting<string>("ConnectionStrings:Default", connectionString);

                _server = GetTestServer();
            }
            catch (Exception ex)
            {
                // xUnit does not dispose a fixture whose constructor throws, so don't leave the container running
                _server?.Dispose();
                if (dbContainer != null)
                    AsyncHelper.RunSync(async () => await dbContainer.DisposeAsync());

                throw new InvalidOperationException("Failed to start test container or server.", ex);
            }
        }

        public static ProductTestServer GetTestServer()
        {
            var hostBuilder = WebHost.CreateDefaultBuilder(new string[0])
                // Same folder SettingsHelpers writes appsettings.json to, whatever the runner's working directory
                .UseContentRoot(AppContext.BaseDirectory)
                .CaptureStartupErrors(true)
                // Lets MVC rebuild its action descriptors so dynamic CRUD controllers for entities that
                // are new to a blank database get routes. Registered here (runs before Startup.ConfigureServices,
                // i.e. before AddMvcCore) so the project Startup does not need to change.
                .ConfigureServices(services =>
                {
                    services.AddSingleton<IActionDescriptorChangeProvider>(SheshaActionDescriptorChangeProvider.Instance);
                    services.AddSingleton(SheshaActionDescriptorChangeProvider.Instance);

                    // CoreTestHelper calls the /hangfire stats endpoints; serve them from a test-only dashboard
                    services.AddSingleton<IStartupFilter, TestHangfireDashboardStartupFilter>();
                })
                .UseStartup<Startup>()
                .UseSetting("detailedErrors", "true")
                .UseEnvironment("Testing");

            return new ProductTestServer(hostBuilder);
        }

        public void Dispose()
        {
            // Stop the server (and its Hangfire workers) while the database is still there to talk to,
            // then remove the container (StopAsync only stops it, so containers pile up between runs)
            _server?.Dispose();
            if (dbContainer != null)
                AsyncHelper.RunSync(async () => await dbContainer.DisposeAsync());
        }
    }

    /// <summary>
    /// Maps a Hangfire dashboard at /hangfire ahead of the app's own pipeline, so the test helpers
    /// reach the stats endpoints without the app's dashboard authorization. Test host only.
    /// </summary>
    internal sealed class TestHangfireDashboardStartupFilter : IStartupFilter
    {
        public Action<IApplicationBuilder> Configure(Action<IApplicationBuilder> next) => app =>
        {
            app.UseHangfireDashboard("/hangfire", new DashboardOptions
            {
                Authorization = new[] { new AllowAllDashboardAuthorizationFilter() }
            });
            next(app);
        };
    }

    internal sealed class AllowAllDashboardAuthorizationFilter : IDashboardAuthorizationFilter
    {
        public bool Authorize(DashboardContext context) => true;
    }

