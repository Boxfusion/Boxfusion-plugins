    [Collection("Sequential")]
    public abstract class IntegrationTestBase
    {
        protected string _adminUser = "admin";
        protected string _adminPass = "123qwe";

        // One constant per Shesha module - the name passed to new SheshaModuleInfo("...")
        const string _sheshaNameSpace = "Shesha";
        {{ModuleNameSpaceConstants}}

        private SheshaTestHelper? _sheshaTestHelper;

        protected DatabaseFixture _fixture;

        public IntegrationTestBase(DatabaseFixture fixture)
        {
            this._fixture = fixture;
        }

        #region Helpers

        public CrudHelperBase<TestPerson> GetTestPersonHelper()
        {
            return new CrudHelperBase<TestPerson>(_sheshaNameSpace, "Person");
        }

        public CrudHelperBase<TestUser> GetTestUserHelper()
        {
            return new CrudHelperBase<TestUser>(_sheshaNameSpace, "User");
        }

        public StoredFileHelper GetTestStoredFileHelper()
        {
            return new StoredFileHelper();
        }

        // GetTest{Entity}Helper() methods for project entities go here

        #endregion

        public SheshaTestHelper GetSheshaTestHelper()
        {
            return _sheshaTestHelper ??= new SheshaTestHelper(this._fixture.connectionString);
        }

        public Task<ProductTestServer> CreateServerAsync()
        {
            return _fixture.GetServerAsync();
        }

        protected async Task<string> LoginAsAdminAsync(HttpClient client)
        {
            var token = await CoreTestHelper.LoginWithTokenAsync(client, _adminUser, _adminPass);
            client.DefaultRequestHeaders.Authorization = new AuthenticationHeaderValue("Bearer", token);
            return token;
        }

        /// <summary>
        /// Starts a scheduled job and waits for it to finish, as admin, then restores the caller's login.
        /// Reading the job execution status needs the Maintenance permission; without it every poll in
        /// StartJobAndWaitForCompleteAsync fails silently and the helper only returns after its 30s timeout.
        /// </summary>
        protected async Task RunJobAsAdminAsync(HttpClient client, Guid jobId)
        {
            var callerAuthorization = client.DefaultRequestHeaders.Authorization;
            try
            {
                await LoginAsAdminAsync(client);
                await CoreTestHelper.StartJobAndWaitForCompleteAsync(client, jobId);
            }
            finally
            {
                client.DefaultRequestHeaders.Authorization = callerAuthorization;
            }
        }

        public virtual async Task CleanAllAsync()
        {
            // Background jobs can still be writing when the next test starts, and resetting the
            // database underneath them deadlocks. Let them drain first, then retry if we still lose a deadlock.
            var server = await CreateServerAsync();
            using (var client = server.CreateClient())
            {
                await CoreTestHelper.WaitForHangfireNotProcessingAsync(client);
            }

            const int maxAttempts = 3;
            for (var attempt = 1; ; attempt++)
            {
                try
                {
                    await GetSheshaTestHelper().CleanDatabaseAsync();
                    return;
                }
                catch (Microsoft.Data.SqlClient.SqlException ex) when (ex.Number == 1205 && attempt < maxAttempts)
                {
                    await Task.Delay(TimeSpan.FromSeconds(attempt));
                }
            }
        }

        protected string ConvertToISODate(DateTime date)
        {
            return date.ToString("o", CultureInfo.InvariantCulture);
        }

        protected string ConvertToISODateNoMilli(DateTime date)
        {
            return ConvertToISODate(date).Split('.')[0];
        }
    }

